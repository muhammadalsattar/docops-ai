# Optional: connect Next.js API routes to the FastAPI backend.
# Leave unset to run the frontend standalone (e.g. on Vercel) using the built-in TF-IDF RAG engine.
FASTAPI_URL=http://localhost:8001

# Backend settings
PORT=8001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Optional: enable OpenAI grounded synthesis in FastAPI; falls back to deterministic extractive RAG if unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
